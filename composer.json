{
    "name": "rushing/php-package-topology",
    "description": "A declarative package-topology substrate for composer monorepos, riding rushing/php-graphine: one TopologyContract spanning two axes \u2014 the composer-require graph (direct edges, reachability, layering, cycles) and the source-import boundary (AST namespace guard) \u2014 plus a testing kit so a repo declares its architecture instead of hand-rolling fitness tests.",
    "keywords": [
        "laravel",
        "topology",
        "architecture",
        "fitness-function",
        "graph",
        "composer",
        "monorepo",
        "substrate"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "galbar/jsonpath": "^3.0",
        "rushing/php-graphine": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nikic/php-parser": "^5.0",
        "pestphp/pest": "^4.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "suggest": {
        "phpunit/phpunit": "The testing kit (AssertsPackageTopology / PackageTopologyConformance) needs a PHPUnit-providing host.",
        "nikic/php-parser": "BSD-3 \u2014 the AST scanner behind graphine's SeamGuard, used by the source-import axis (sourceNeverReferences)."
    },
    "autoload": {
        "psr-4": {
            "Rushing\\PackageTopology\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\PackageTopology\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-graphine",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-graphine.git"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    }
}
